# -------------------------------
# Frontend API
# -------------------------------
# Optional. Leave empty for same-host local development (frontend :5173 -> API :8000).
# Values: Empty for same-host development, or an absolute HTTP(S) backend base URL.
VITE_API_BASE_URL=

# Public, build-time sharing metadata. Rebuild after changing these values.
# Optional HTTP(S) origin only, e.g. https://your-domain.example (no path/query).
# Empty omits social URL/image tags; never put credentials here.
VITE_PUBLIC_SITE_URL=
# Optional public description; defaults to template copy or the configured project name.
VITE_SITE_DESCRIPTION=
